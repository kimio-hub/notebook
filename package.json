{
  "name": "kimio-site",
  "description": "Kimio's personal website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "sync-notes": "node ./scripts/sync-notes.mjs",
    "dev": "npm run sync-notes && astro dev",
    "build": "npm run sync-notes && astro build",
    "preview": "astro preview",
    "test": "node --test",
    "typecheck": "astro check",
    "check:site": "node ./scripts/check-built-site.mjs",
    "site:check": "npm run test && npm run typecheck && npm run build && npm run check:site"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/sitemap": "^3.4.1",
    "astro": "^7.0.7",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3"
  }
}
