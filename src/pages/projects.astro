---
import BaseLayout from "../layouts/BaseLayout.astro"
import { isExternalHref, projects, statusLabel } from "../data/projects"
import { site } from "../data/site"

const sorted = [...projects].sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""))
const completed = sorted.filter((p) => p.status === "completed").length
---

<BaseLayout title="项目" description={`${site.name} 的已完成项目与作品集。`}>
  <header class="page-intro">
    <h1>项目</h1>
    <p>这里放我已经做完、愿意公开的项目与复盘。后续完成的作品会继续往这里加。</p>
  </header>

  <div
    class="hero-side"
    style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.75rem;margin-bottom:1.4rem;"
  >
    <div class="panel stat-card">
      <div class="label">全部</div>
      <div class="value">{sorted.length}</div>
    </div>
    <div class="panel stat-card">
      <div class="label">已完成</div>
      <div class="value">{completed}</div>
    </div>
  </div>

  {
    sorted.length === 0 ? (
      <p style="color: var(--muted);">还没有公开项目，稍后再来看看。</p>
    ) : (
      <div class="card-grid project-grid">
        {sorted.map((project) => {
          const external = isExternalHref(project.href)
          return (
            <article class="project-card">
              <div class="meta">
                <span
                  class={`tag ${project.status === "completed" ? "tag-brand" : project.status === "wip" ? "tag-accent" : ""}`}
                >
                  {statusLabel[project.status]}
                </span>
                {project.date && <time>{project.date}</time>}
              </div>
              <h3>
                <a
                  href={project.href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  {project.title}
                </a>
              </h3>
              <p>{project.description}</p>
              {project.tags && project.tags.length > 0 && (
                <div class="tags">
                  {project.tags.map((tag) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )}
              <div class="project-actions">
                <a
                  class="btn btn-primary"
                  href={project.href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  {external ? "查看详情" : "阅读报告"}
                </a>
                {project.links
                  ?.filter((l) => l.href !== project.href)
                  .map((link) => {
                    const linkExt = isExternalHref(link.href)
                    return (
                      <a
                        class="btn btn-ghost"
                        href={link.href}
                        target={linkExt ? "_blank" : undefined}
                        rel={linkExt ? "noopener noreferrer" : undefined}
                      >
                        {link.label}
                      </a>
                    )
                  })}
              </div>
            </article>
          )
        })}
      </div>
    )
  }

  <section class="friend-guide" style="margin-top: 2rem;">
    <h2 style="margin:0 0 0.5rem;font-size:1.2rem;">更多动态</h2>
    <p style="margin:0;color:var(--ink-soft);">
      项目长文维护在 <code>src/content/writeups/</code>；列表在 <code>src/data/projects.ts</code>。
      也可关注
      {
        site.zhihu ? (
          <a href={site.zhihu} target="_blank" rel="noopener noreferrer">
            知乎主页
          </a>
        ) : (
          "知乎"
        )
      }
      与
      <a href={site.github} target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      。
    </p>
  </section>
</BaseLayout>
