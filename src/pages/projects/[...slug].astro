---
import { getCollection, render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { formatDate } from "../../lib/notes"

export async function getStaticPaths() {
  const writeups = await getCollection("writeups", ({ data }) => !data.draft)
  return writeups.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3)
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description ?? entry.data.title}
>
  <div class="note-layout">
    <article class="article-card">
      <div class="article-meta">
        <a href="/projects/">项目</a>
        {
          entry.data.date && (
            <>
              <span>·</span>
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date)}
              </time>
            </>
          )
        }
      </div>
      <h1>{entry.data.title}</h1>
      {
        entry.data.tags?.length > 0 && (
          <div class="tag-row" style="margin: 0 0 1.2rem;">
            {entry.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>

    {
      toc.length > 0 && (
        <aside class="toc" aria-label="本页目录">
          <h2>目录</h2>
          <ul>
            {toc.map((h) => (
              <li style={`padding-left: ${(h.depth - 2) * 0.75}rem`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <p style="margin-top: 1.5rem;">
    <a class="btn btn-ghost" href="/projects/">← 返回项目列表</a>
  </p>
</BaseLayout>
