---
import BaseLayout from "../layouts/BaseLayout.astro"
import { site } from "../data/site"
import { getPublishedNotes } from "../lib/notes"

const notes = await getPublishedNotes()
---

<BaseLayout title="关于" description={`关于 ${site.name}：${site.role}`}>
  <header class="page-intro">
    <h1>关于</h1>
    <p>{site.role}</p>
  </header>

  <div class="about-grid">
    <section class="panel about-panel">
      <h2 style="margin-top:0;font-size:1.3rem;">我是谁</h2>
      <p>{site.bio}</p>
      <p>
        这个网站是我的公开名片与学习日志：记录正在打磨的基础、读过的论文，以及一点点还没想完的问题。
      </p>
      <p class="quote">「{site.tagline}」</p>
    </section>

    <section class="panel about-panel">
      <h2 style="margin-top:0;font-size:1.3rem;">此刻</h2>
      <div class="tag-row">
        {site.interests.map((item) => <span class="tag tag-brand">{item}</span>)}
      </div>
      <p style="margin-top:1rem;">
        已公开笔记 <strong style="color:var(--ink)">{notes.length}</strong> 篇。
      </p>
      <div class="hero-actions" style="margin-top:1rem;">
        <a class="btn btn-primary" href="/notes/">阅读笔记</a>
        <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </section>
  </div>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>关于本站</h2>
        <p>技术栈与更新方式</p>
      </div>
    </div>
    <div class="panel about-panel">
      <ul>
        <li><strong>框架：</strong>Astro 静态站点，部署于 Cloudflare Pages</li>
        <li><strong>内容：</strong>本地笔记同步发布（基础 / 论文两条线）</li>
        <li><strong>动态：</strong>可视化更新时间线（站点里程碑 + 笔记改动）</li>
        <li><strong>友链：</strong>见 <a href="/friends/">友链页</a></li>
        <li><strong>不再提供 RSS</strong>，请直接关注「更新」页或 GitHub</li>
      </ul>
    </div>
  </section>
</BaseLayout>
