---
import BaseLayout from "../layouts/BaseLayout.astro"
import { friendLinkGuide, friends } from "../data/friends"

function initial(name: string) {
  return name.trim().charAt(0).toUpperCase()
}
---

<BaseLayout title="友链" description="Kimio 的友情链接：互相看见的个人站点。">
  <header class="page-intro">
    <h1>友链</h1>
    <p>一些我喜欢、也希望你遇见的个人站点。欢迎互换链接。</p>
  </header>

  <div class="card-grid">
    {
      friends.map((friend) => (
        <a class="friend-card" href={friend.url} target="_blank" rel="noopener noreferrer">
          {friend.avatar ? (
            <img class="friend-avatar" src={friend.avatar} alt="" width="52" height="52" />
          ) : (
            <div class="friend-avatar" aria-hidden="true">
              {initial(friend.name)}
            </div>
          )}
          <div style="min-width: 0;">
            <div class="meta">
              {friend.tags?.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <h3 style="margin-top: 0.35rem;">{friend.name}</h3>
            <p>{friend.description}</p>
            <div class="meta" style="margin-top: 0.45rem; word-break: break-all;">
              {friend.url.replace(/^https?:\/\//, "")}
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <section class="friend-guide">
    <h2>{friendLinkGuide.title}</h2>
    <p style="margin: 0; color: var(--ink-soft);">{friendLinkGuide.intro}</p>
    {
      friendLinkGuide.requirements?.length ? (
        <ul>
          {friendLinkGuide.requirements.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ) : null
    }

    <p style="margin: 0 0 0.5rem; font-weight: 700; color: var(--ink);">本站信息</p>
    <div class="mine-card">
      <div><strong>名称：</strong>{friendLinkGuide.mine.name}</div>
      <div><strong>链接：</strong><code>{friendLinkGuide.mine.url}</code></div>
      <div><strong>简介：</strong>{friendLinkGuide.mine.description}</div>
      <div><strong>头像：</strong><code>{friendLinkGuide.mine.avatar}</code></div>
    </div>

    <p style="margin: 0.9rem 0 0; color: var(--muted); font-size: 0.92rem;">
      {friendLinkGuide.contact}
      编辑友链请改仓库中的 <code>src/data/friends.ts</code>。
    </p>
  </section>
</BaseLayout>
