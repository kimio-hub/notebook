---
import { render } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import ArticleShell from "../components/ArticleShell.astro"
import NoteEntry from "../components/NoteEntry.astro"
import type { Locale } from "../i18n/config"
import { localizePath, t } from "../i18n/utils"
import { categoryLabel, getPublishedNotes, readingMinutes, type NoteEntry as Note } from "../lib/notes"

interface Props {
  lang: Locale
  note: Note
}

const { lang, note } = Astro.props
const { Content, headings } = await render(note)
const { category, series } = note.data
const date = note.data.updated ?? note.data.date

const siblings = (await getPublishedNotes()).filter((n) => n.id !== note.id && n.data.category === category)
const related = [
  ...siblings.filter((n) => series && n.data.series === series),
  ...siblings.filter((n) => !series || n.data.series !== series),
].slice(0, 3)

const crumbs = [
  { label: t(lang, "nav.notes"), href: localizePath("/notes/", lang) },
  {
    label: categoryLabel(category, lang),
    href: category === "other" ? undefined : localizePath(`/notes/${category}/`, lang),
    cat: category,
  },
  ...(series ? [{ label: series }] : []),
]
---

<BaseLayout lang={lang} title={note.data.title} description={note.data.description ?? note.data.title} type="article">
  <ArticleShell
    lang={lang}
    title={note.data.title}
    description={note.data.description}
    crumbs={crumbs}
    date={date}
    minutes={readingMinutes(note.body)}
    tags={note.data.tags}
    headings={headings}
    cover={{ seed: note.id, kind: category }}
  >
    <Content />
    <footer class="article-footer" slot="footer">
      {
        related.length > 0 && (
          <>
            <div class="section-head">
              <h2>{t(lang, "notes.more", { category: categoryLabel(category, lang) })}</h2>
            </div>
            <ul class="entry-list">
              {related.map((n) => (
                <NoteEntry note={n} lang={lang} kicker={false} date="none" />
              ))}
            </ul>
          </>
        )
      }
      <a class="pill-link back-link" href={localizePath("/notes/", lang)}>{t(lang, "notes.back")}</a>
    </footer>
  </ArticleShell>
</BaseLayout>
