---
import BaseLayout from "../layouts/BaseLayout.astro"
import ProfileLinks from "../components/ProfileLinks.astro"
import { site, siteBio, siteInterests, siteRole, siteTagline } from "../data/site"
import type { Locale } from "../i18n/config"
import { localizePath, t } from "../i18n/utils"
import { categoryLabel, getPublishedNotes, noteCategories } from "../lib/notes"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const notes = await getPublishedNotes()
const counts = noteCategories.map((cat) => ({ cat, count: notes.filter((n) => n.data.category === cat).length }))
---

<BaseLayout lang={lang} title={t(lang, "about.title")} description={`${t(lang, "about.title")} ${site.name}: ${siteRole(lang)}`}>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">{siteRole(lang)}</p>
      <h1>{t(lang, "about.title")}</h1>
    </header>

    <div class="about-grid">
      <div class="prose">
        <p>{siteBio(lang)}</p>
        <p>{t(lang, "about.siteCard")}</p>
        <blockquote><p>{siteTagline(lang)}</p></blockquote>

        <h2>{t(lang, "about.now")}</h2>
        <ul>
          {siteInterests(lang).map((item) => <li>{item}</li>)}
        </ul>
        <p>
          {t(lang, "about.notesCount", { count: notes.length })}
          {" "}
          {counts.map(({ cat, count }, index) => (
            <>
              {index > 0 && " · "}
              <a href={localizePath(`/notes/${cat}/`, lang)}>{categoryLabel(cat, lang)} {count}</a>
            </>
          ))}
        </p>

        <h2>{t(lang, "about.siteTitle")}</h2>
        <ul>
          <li>{t(lang, "about.liFramework")}</li>
          <li>{t(lang, "about.liContent")}</li>
          <li>{t(lang, "about.liUpdates")} (<a href={localizePath("/updates/", lang)}>{t(lang, "nav.updates")}</a>)</li>
          <li>{t(lang, "about.liFriends")} (<a href={localizePath("/friends/", lang)}>{t(lang, "nav.friends")}</a>)</li>
          <li>{t(lang, "about.liRss")}</li>
        </ul>
      </div>

      <aside class="side-panel">
        <h2>{t(lang, "about.contact")}</h2>
        <ProfileLinks lang={lang} />
      </aside>
    </div>
  </div>
</BaseLayout>
