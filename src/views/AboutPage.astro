---
import BaseLayout from "../layouts/BaseLayout.astro"
import { site, siteBio, siteInterests, siteRole, siteTagline } from "../data/site"
import type { Locale } from "../i18n/config"
import { localizePath, t } from "../i18n/utils"
import { getPublishedNotes } from "../lib/notes"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const notes = await getPublishedNotes()
---

<BaseLayout lang={lang} title={t(lang, "about.title")} description={`${t(lang, "about.title")} ${site.name}: ${siteRole(lang)}`}>
  <header class="page-intro">
    <h1>{t(lang, "about.title")}</h1>
    <p>{siteRole(lang)}</p>
  </header>

  <div class="about-grid">
    <section class="panel about-panel">
      <h2 style="margin-top:0;font-size:1.3rem;">{t(lang, "about.who")}</h2>
      <p>{siteBio(lang)}</p>
      <p>{t(lang, "about.siteCard")}</p>
      <p class="quote">「{siteTagline(lang)}」</p>
    </section>

    <section class="panel about-panel">
      <h2 style="margin-top:0;font-size:1.3rem;">{t(lang, "about.now")}</h2>
      <div class="tag-row">
        {siteInterests(lang).map((item) => <span class="tag tag-brand">{item}</span>)}
      </div>
      <p style="margin-top:1rem;">
        {t(lang, "about.notesCount", { count: notes.length })}
      </p>
      <div class="hero-actions" style="margin-top:1rem;">
        <a class="btn btn-primary" href={localizePath("/notes/", lang)}>{t(lang, "about.readNotes")}</a>
        <a class="btn btn-ghost" href={localizePath("/projects/", lang)}>{t(lang, "about.projects")}</a>
        <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener noreferrer">{t(lang, "action.github")}</a>
        {
          site.zhihu && (
            <a class="btn btn-ghost" href={site.zhihu} target="_blank" rel="noopener noreferrer">
              {t(lang, "action.zhihu")}
            </a>
          )
        }
        {
          site.email && (
            <a class="btn btn-ghost" href={`mailto:${site.email}`}>
              {t(lang, "action.email")}
            </a>
          )
        }
      </div>
      <div style="margin-top:1rem;color:var(--muted);font-size:0.92rem;display:grid;gap:0.35rem;">
        {
          site.email && (
            <p style="margin:0;">
              <strong style="color:var(--ink);">{t(lang, "about.emailLabel")}</strong>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          )
        }
        {
          site.zhihu && (
            <p style="margin:0;">
              <strong style="color:var(--ink);">{t(lang, "about.zhihuLabel")}</strong>
              <a href={site.zhihu} target="_blank" rel="noopener noreferrer">
                {site.zhihu.replace(/^https?:\/\//, "")}
              </a>
            </p>
          )
        }
      </div>
    </section>
  </div>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>{t(lang, "about.siteTitle")}</h2>
        <p>{t(lang, "about.siteSubtitle")}</p>
      </div>
    </div>
    <div class="panel about-panel">
      <ul>
        <li>{t(lang, "about.liFramework")}</li>
        <li>{t(lang, "about.liContent")}</li>
        <li>{t(lang, "about.liUpdates")}</li>
        <li>
          {t(lang, "about.liProjects")} (<a href={localizePath("/projects/", lang)}>{t(lang, "nav.projects")}</a>)
        </li>
        <li>
          {t(lang, "about.liFriends")} (<a href={localizePath("/friends/", lang)}>{t(lang, "nav.friends")}</a>)
        </li>
        <li>{t(lang, "about.liRss")}</li>
      </ul>
    </div>
  </section>
</BaseLayout>
