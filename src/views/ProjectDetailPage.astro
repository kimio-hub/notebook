---
import { render, type CollectionEntry } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import type { Locale } from "../i18n/config"
import { localizePath, t } from "../i18n/utils"
import { formatDate } from "../lib/notes"

interface Props {
  lang: Locale
  entry: CollectionEntry<"writeups">
}

const { lang, entry } = Astro.props
const { Content, headings } = await render(entry)
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3)
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description ?? entry.data.title}
>
  {
    lang === "en" && (
      <p class="panel about-panel" style="margin-bottom:1rem;padding:0.85rem 1rem;font-size:0.9rem;color:var(--muted);">
        {t(lang, "projects.contentLangNote")}
      </p>
    )
  }
  <div class="note-layout">
    <article class="article-card">
      <div class="article-meta">
        <a href={localizePath("/projects/", lang)}>{t(lang, "nav.projects")}</a>
        {
          entry.data.date && (
            <>
              <span>·</span>
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date, lang)}
              </time>
            </>
          )
        }
      </div>
      <h1>{entry.data.title}</h1>
      {
        entry.data.tags?.length > 0 && (
          <div class="tag-row" style="margin: 0 0 1.2rem;">
            {entry.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>

    {
      toc.length > 0 && (
        <aside class="toc" aria-label={t(lang, "notes.toc")}>
          <h2>{t(lang, "notes.toc")}</h2>
          <ul>
            {toc.map((h) => (
              <li style={`padding-left: ${(h.depth - 2) * 0.75}rem`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <p style="margin-top: 1.5rem;">
    <a class="btn btn-ghost" href={localizePath("/projects/", lang)}>{t(lang, "projects.back")}</a>
  </p>
</BaseLayout>
