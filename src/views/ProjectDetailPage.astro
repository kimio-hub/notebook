---
import { render, type CollectionEntry } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import ArticleShell from "../components/ArticleShell.astro"
import type { Locale } from "../i18n/config"
import { localizePath, t } from "../i18n/utils"
import { readingMinutes } from "../lib/notes"

interface Props {
  lang: Locale
  entry: CollectionEntry<"writeups">
}

const { lang, entry } = Astro.props
const { Content, headings } = await render(entry)
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description ?? entry.data.title} type="article">
  <ArticleShell
    lang={lang}
    title={entry.data.title}
    description={entry.data.description}
    crumbs={[{ label: t(lang, "nav.projects"), href: localizePath("/projects/", lang) }]}
    date={entry.data.date}
    minutes={readingMinutes(entry.body)}
    tags={entry.data.tags}
    headings={headings}
  >
    <Content />
    <footer class="article-footer" slot="footer">
      <a class="pill-link back-link" href={localizePath("/projects/", lang)}>{t(lang, "projects.back")}</a>
    </footer>
  </ArticleShell>
</BaseLayout>
