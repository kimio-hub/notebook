---
import BaseLayout from "../layouts/BaseLayout.astro"
import { friendDescription, friendGuide, friends, friendTags } from "../data/friends"
import type { Locale } from "../i18n/config"
import { t } from "../i18n/utils"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const guide = friendGuide(lang)

function initial(name: string) {
  return name.trim().charAt(0).toUpperCase()
}
---

<BaseLayout lang={lang} title={t(lang, "friends.title")} description={t(lang, "friends.desc")}>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">{t(lang, "friends.eyebrow")}</p>
      <h1>{t(lang, "friends.title")}</h1>
      <p class="intro">{t(lang, "friends.intro")}</p>
    </header>

    <ul class="friend-list">
      {
        friends.map((friend) => (
          <li class="friend">
            {friend.avatar ? (
              <img class="friend-avatar" src={friend.avatar} alt="" width="48" height="48" />
            ) : (
              <span class="friend-avatar" aria-hidden="true">{initial(friend.name)}</span>
            )}
            <div>
              <h2 class="entry-title">
                <a href={friend.url} target="_blank" rel="noopener noreferrer">{friend.name}</a>
              </h2>
              <p class="entry-dek">{friendDescription(friend, lang)}</p>
              <p class="entry-meta">
                <span class="friend-url">{friend.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}</span>
                {friendTags(friend, lang)?.length ? (
                  <span class="tag-list">
                    {friendTags(friend, lang)?.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </span>
                ) : null}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <section class="note-panel">
      <h2>{guide.title}</h2>
      <p style="margin:0">{guide.intro}</p>
      {
        guide.requirements?.length ? (
          <ul>
            {guide.requirements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ) : null
      }
      <dl>
        <dt>{t(lang, "friends.name")}</dt><dd>{guide.mine.name}</dd>
        <dt>{t(lang, "friends.link")}</dt><dd><code>{guide.mine.url}</code></dd>
        <dt>{t(lang, "friends.blurb")}</dt><dd>{guide.mine.description}</dd>
        <dt>{t(lang, "friends.avatar")}</dt><dd><code>{guide.mine.avatar}</code></dd>
      </dl>
      <p style="margin:16px 0 0;color:var(--muted)">{guide.contact}</p>
    </section>
  </div>
</BaseLayout>
