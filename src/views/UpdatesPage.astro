---
import BaseLayout from "../layouts/BaseLayout.astro"
import {
  changelog,
  changelogHref,
  changelogSummary,
  changelogTitle,
  typeLabel,
  type ChangelogItem,
} from "../data/changelog"
import type { Locale } from "../i18n/config"
import { t } from "../i18n/utils"
import { categoryLabel, formatDateShort, getPublishedNotes } from "../lib/notes"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const notes = await getPublishedNotes()

const noteItems: ChangelogItem[] = notes.map((note) => ({
  date: formatDateShort(note.data.updated ?? note.data.date) || "2026-01-01",
  title: note.data.title,
  titleEn: note.data.title,
  summary: `${categoryLabel(note.data.category, "zh")}${note.data.series ? ` · ${note.data.series}` : ""}`,
  summaryEn: `${categoryLabel(note.data.category, "en")}${note.data.series ? ` · ${note.data.series}` : ""}`,
  type: "note",
  href: `/notes/${note.id}/`,
}))

const all = [...changelog, ...noteItems].sort((a, b) => b.date.localeCompare(a.date))
const years = new Map<string, ChangelogItem[]>()
for (const item of all) years.set(item.date.slice(0, 4), [...(years.get(item.date.slice(0, 4)) ?? []), item])

const filters = [
  { key: "all", label: t(lang, "updates.all"), count: all.length },
  ...(["site", "note", "project"] as const).map((key) => ({
    key,
    label: t(lang, `updates.${key}`),
    count: all.filter((i) => i.type === key).length,
  })),
]
---

<BaseLayout lang={lang} title={t(lang, "updates.title")} description={t(lang, "updates.desc")}>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">{t(lang, "updates.eyebrow")}</p>
      <h1>{t(lang, "updates.title")}</h1>
      <p class="intro">{t(lang, "updates.intro")}</p>
    </header>

    <div class="tabs" id="update-filters" role="group" aria-label={t(lang, "updates.filterAria")}>
      {
        filters.map((f) => (
          <button type="button" data-filter={f.key} aria-pressed={f.key === "all" ? "true" : "false"}>
            {f.label}
            <span class="count">{f.count}</span>
          </button>
        ))
      }
    </div>

    {
      [...years.entries()].map(([year, items]) => (
        <section class="year-group" data-year-group>
          <h2 class="year-label">{year}</h2>
          <ul class="entry-list">
            {items.map((item) => {
              const href = changelogHref(item, lang)
              return (
                <li class="entry" data-type={item.type}>
                  <time class="entry-date" datetime={item.date}>{item.date.slice(5)}</time>
                  <div>
                    <p class="entry-kicker">{typeLabel(item.type, lang)}</p>
                    <h3 class="entry-title">{href ? <a href={href}>{changelogTitle(item, lang)}</a> : changelogTitle(item, lang)}</h3>
                    <p class="entry-dek">{changelogSummary(item, lang)}</p>
                  </div>
                </li>
              )
            })}
          </ul>
        </section>
      ))
    }

    <p class="page-foot">{t(lang, "updates.hint")}</p>
  </div>
</BaseLayout>

<script>
  const bar = document.getElementById("update-filters")
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-year-group] .entry"))
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-year-group]"))

  bar?.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement).closest("button")
    if (!target) return
    const filter = target.dataset.filter ?? "all"
    bar.querySelectorAll("button").forEach((btn) => btn.setAttribute("aria-pressed", String(btn === target)))
    items.forEach((item) => {
      item.hidden = !(filter === "all" || item.dataset.type === filter)
    })
    groups.forEach((group) => {
      group.hidden = !group.querySelector(".entry:not([hidden])")
    })
  })
</script>
