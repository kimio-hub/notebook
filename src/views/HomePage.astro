---
import BaseLayout from "../layouts/BaseLayout.astro"
import Cover from "../components/Cover.astro"
import NoteCard from "../components/NoteCard.astro"
import ProfileLinks from "../components/ProfileLinks.astro"
import ProjectEntry from "../components/ProjectEntry.astro"
import { changelog, changelogHref, changelogSummary, changelogTitle, typeLabel } from "../data/changelog"
import { projects } from "../data/projects"
import { site, siteBio, siteDescription, siteInterests, siteRole } from "../data/site"
import type { Locale } from "../i18n/config"
import { localizePath, t } from "../i18n/utils"
import { categoryLabel, formatDateShort, getPublishedNotes, noteCategories, noteHref } from "../lib/notes"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const notes = await getPublishedNotes()
const affiliation = t(lang, "site.affiliation")

const featured = [
  ...notes.filter((n) => n.data.feature),
  ...notes.filter((n) => !n.data.feature && n.data.category === "blog"),
].slice(0, 5)
const [lead, ...cards] = featured

const news = [...changelog].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6)
const sortedProjects = [...projects].sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""))

const stats = [
  ...noteCategories.map((cat) => ({
    href: `/notes/${cat}/`,
    label: categoryLabel(cat, lang),
    count: notes.filter((n) => n.data.category === cat).length,
    cat: cat as string,
  })),
  { href: "/projects/", label: t(lang, "home.statProjects"), count: projects.length, cat: "project" },
]

const indexColumns = (["papers", "courses", "basics"] as const).map((cat) => {
  const items = notes.filter((n) => n.data.category === cat)
  return { cat, items: items.slice(0, 4), count: items.length }
})
---

<BaseLayout lang={lang} title={site.title} description={siteDescription(lang)}>
  <div class="container home">
    <section class="hero" aria-label={t(lang, "home.about")}>
      <aside class="profile-card">
        <div class="profile-band">
          <Cover seed="profile" kind="project" width={300} height={110} />
        </div>
        <img class="profile-avatar" src="/avatar.webp" alt={site.name} width="120" height="120" />
        <h1 class="profile-name">{site.name}</h1>
        <p class="profile-role">{siteRole(lang)}</p>
        {affiliation && <p class="profile-aff">{affiliation}</p>}
        <ProfileLinks lang={lang} />
      </aside>

      <div class="hero-intro">
        <p class="hero-headline">
          {t(lang, "home.headline")}<mark>{t(lang, "home.headlineMark")}</mark>
        </p>
        <div class="bio">
          <p>{siteBio(lang)}</p>
          <p>{t(lang, "home.bio2")}</p>
        </div>
        <div class="interests">
          <span class="label">{t(lang, "home.interests")}</span>
          {siteInterests(lang).map((item) => <span class="chip">{item}</span>)}
        </div>
        <ul class="stats" aria-label={t(lang, "home.statsAria")}>
          {
            stats.map((stat) => (
              <li>
                <a href={localizePath(stat.href, lang)} data-cat={stat.cat}>
                  <span class="stat-count">{stat.count}</span>
                  <span class="stat-label">{stat.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      lead && (
        <section class="home-section" aria-labelledby="home-writing">
          <div class="section-head">
            <h2 id="home-writing">
              <span class="section-no">01</span>
              {t(lang, "home.selected")}
            </h2>
            <a class="more-link" href={localizePath("/notes/", lang)}>{t(lang, "home.allNotes")}</a>
          </div>
          <NoteCard note={lead} lang={lang} variant="lead" />
          <div class="card-grid">
            {cards.map((note) => <NoteCard note={note} lang={lang} />)}
          </div>
        </section>
      )
    }

    <div class="home-split">
      <section class="home-section" aria-labelledby="home-news">
        <div class="section-head">
          <h2 id="home-news">
            <span class="section-no">02</span>
            {t(lang, "home.news")}
          </h2>
          <a class="more-link" href={localizePath("/updates/", lang)}>{t(lang, "home.allUpdates")}</a>
        </div>
        <ol class="timeline">
          {
            news.map((item) => {
              const href = changelogHref(item, lang)
              return (
                <li data-type={item.type}>
                  <p class="timeline-meta">
                    <time datetime={item.date}>{item.date}</time>
                    <span>{typeLabel(item.type, lang)}</span>
                  </p>
                  <p class="timeline-title">{href ? <a href={href}>{changelogTitle(item, lang)}</a> : changelogTitle(item, lang)}</p>
                  <p class="timeline-summary">{changelogSummary(item, lang)}</p>
                </li>
              )
            })
          }
        </ol>
      </section>

      <section class="home-section" aria-labelledby="home-projects">
        <div class="section-head">
          <h2 id="home-projects">
            <span class="section-no">03</span>
            {t(lang, "home.projects")}
          </h2>
          <a class="more-link" href={localizePath("/projects/", lang)}>{t(lang, "home.allProjects")}</a>
        </div>
        <ul class="entry-list project-stack">
          {sortedProjects.slice(0, 3).map((project) => <ProjectEntry project={project} lang={lang} compact />)}
        </ul>
      </section>
    </div>

    <section class="home-section" aria-labelledby="home-notes">
      <div class="section-head">
        <h2 id="home-notes">
          <span class="section-no">04</span>
          {t(lang, "home.notesIndex")}
        </h2>
        <a class="more-link" href={localizePath("/notes/", lang)}>{t(lang, "home.allNotes")}</a>
      </div>
      <div class="notes-index">
        {
          indexColumns.map(({ cat, items, count }) => (
            <div class="index-panel" data-cat={cat}>
              <div class="index-head">
                <h3>
                  <a href={localizePath(`/notes/${cat}/`, lang)}>{categoryLabel(cat, lang)}</a>
                </h3>
                <span class="index-count">{count}</span>
              </div>
              <p>{t(lang, `home.index.${cat}`)}</p>
              <ul>
                {items.map((note) => (
                  <li>
                    <a href={noteHref(note, lang)}>{note.data.title}</a>
                    <time datetime={formatDateShort(note.data.updated ?? note.data.date)}>
                      {formatDateShort(note.data.updated ?? note.data.date).slice(5)}
                    </time>
                  </li>
                ))}
              </ul>
              <a class="more-link" href={localizePath(`/notes/${cat}/`, lang)}>
                {t(lang, "home.viewAll")}
              </a>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
