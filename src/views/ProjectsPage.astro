---
import BaseLayout from "../layouts/BaseLayout.astro"
import ProjectEntry from "../components/ProjectEntry.astro"
import { projects } from "../data/projects"
import { site } from "../data/site"
import type { Locale } from "../i18n/config"
import { t } from "../i18n/utils"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const sorted = [...projects].sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""))
---

<BaseLayout lang={lang} title={t(lang, "projects.title")} description={t(lang, "projects.desc")}>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">{t(lang, "projects.eyebrow")}</p>
      <h1>{t(lang, "projects.title")}</h1>
      <p class="intro">{t(lang, "projects.intro")}</p>
    </header>

    <div class="section-head"><h2>{t(lang, "projects.listTitle", { count: sorted.length })}</h2></div>
    {
      sorted.length === 0 ? (
        <p class="empty">{t(lang, "projects.empty")}</p>
      ) : (
        <ul class="entry-list">
          {sorted.map((project) => (
            <ProjectEntry project={project} lang={lang} />
          ))}
        </ul>
      )
    }

    <p class="page-foot">
      {t(lang, "projects.moreBody")}
      {
        site.zhihu && (
          <>
            {" "}
            <a href={site.zhihu} target="_blank" rel="noopener noreferrer">{t(lang, "action.zhihu")}</a>
            {" · "}
          </>
        )
      }
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
  </div>
</BaseLayout>
