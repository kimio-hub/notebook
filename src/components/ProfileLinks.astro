---
import { site } from "../data/site"
import type { Locale } from "../i18n/config"
import { t } from "../i18n/utils"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
---

<ul class="profile-links">
  {
    site.email && (
      <li>
        <a href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m4 7 8 6 8-6" />
          </svg>
          <span class="visually-hidden">{t(lang, "action.email")}: </span>
          {site.email}
        </a>
      </li>
    )
  }
  <li>
    <a href={site.github} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.73.5.75 5.48.75 11.76c0 4.98 3.23 9.2 7.7 10.69.56.1.77-.24.77-.54v-1.92c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 .1.72 1.72 2.72 1.72.76 0 1.42-.2 1.77-.4.1-.68.39-1.16.71-1.43-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.42.11-2.96 0 0 .95-.3 3.1 1.15a10.7 10.7 0 0 1 5.64 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.54.23 2.68.11 2.96.72.79 1.16 1.8 1.16 3.02 0 4.32-2.64 5.27-5.15 5.55.4.34.76 1.02.76 2.06v3.05c0 .3.2.65.78.54 4.46-1.49 7.68-5.71 7.68-10.69C23.25 5.48 18.27.5 12 .5Z" />
      </svg>
      <span class="visually-hidden">GitHub: </span>
      {site.githubUser}
    </a>
  </li>
  {
    site.zhihu && (
      <li>
        <a href={site.zhihu} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M4 5h16v11H9l-5 4z" />
            <path d="M9 9h6M9 12h4" />
          </svg>
          {t(lang, "action.zhihu")}
        </a>
      </li>
    )
  }
</ul>
