---
import {
  changelogHref,
  changelogSummary,
  changelogTitle,
  typeLabel,
  type ChangelogItem,
} from "../data/changelog"
import type { Locale } from "../i18n/config"

interface Props {
  item: ChangelogItem
  lang?: Locale
}

const { item, lang = "zh" } = Astro.props
const label = typeLabel(item.type, lang)
const href = changelogHref(item, lang)
const title = changelogTitle(item, lang)
const summary = changelogSummary(item, lang)
---

<article class="timeline-item" data-type={item.type}>
  <div class="timeline-dot" aria-hidden="true"></div>
  <div class="timeline-body">
    <div class="meta" style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
      <time datetime={item.date}>{item.date}</time>
      <span class={`tag ${item.type === "note" ? "tag-accent" : "tag-brand"}`}>{label}</span>
    </div>
    <h3>
      {href ? <a href={href}>{title}</a> : title}
    </h3>
    <p>{summary}</p>
  </div>
</article>
