---
import type { Locale } from "../i18n/config"
import { getNav, t } from "../i18n/utils"
import { site, siteTagline } from "../data/site"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const year = new Date().getFullYear()
const nav = getNav(lang)
---

<footer class="site-footer">
  <div class="container inner">
    <div>
      <strong style="color: var(--ink); font-family: var(--font-serif);">{site.name}</strong>
      <div style="margin-top: 0.25rem;">{siteTagline(lang)}</div>
      <div style="margin-top: 0.35rem;">{t(lang, "footer.built", { year })}</div>
    </div>
    <nav aria-label={t(lang, "nav.footer")}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={site.github} target="_blank" rel="noopener noreferrer">{t(lang, "action.github")}</a>
      {
        site.zhihu && (
          <a href={site.zhihu} target="_blank" rel="noopener noreferrer">
            {t(lang, "action.zhihu")}
          </a>
        )
      }
      {site.email && <a href={`mailto:${site.email}`}>{t(lang, "action.email")}</a>}
    </nav>
  </div>
</footer>
