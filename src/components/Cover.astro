---
/**
 * Generated cover art: a flat colour ground with thick ink line drawings.
 * The motif depends on the kind (one metaphor per category) and is varied
 * deterministically by `seed`, so every note keeps the same picture across builds.
 */
interface Props {
  seed: string
  kind: string
  /** viewBox size; the art is laid out for this aspect ratio. */
  width?: number
  height?: number
  class?: string
}

const { seed, kind, width: w = 320, height: h = 200, class: className } = Astro.props

function hash(text: string) {
  let x = 2166136261
  for (const ch of text) x = Math.imul(x ^ ch.codePointAt(0)!, 16777619)
  return x >>> 0
}

function rng(start: number) {
  let a = start
  return () => {
    a = (a + 0x6d2b79f5) | 0
    let t = Math.imul(a ^ (a >>> 15), 1 | a)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

const r = rng(hash(`${kind}:${seed}`))
const between = (lo: number, hi: number) => lo + (hi - lo) * r()
const pick = <T,>(items: T[]) => items[Math.floor(r() * items.length)]
const f = (n: number) => Math.round(n * 10) / 10

const s = Math.min(w, h) / 200
const sw = f(2.6 * s)
const ink = "#141413"
const paper = "#faf9f5"
const deep: Record<string, string> = {
  blog: "#d97757",
  papers: "#6a9bcc",
  courses: "#788c5d",
  basics: "#918bd6",
  project: "#d4a27f",
  other: "#bdbaae",
}
const accent = deep[kind] ?? deep.other
const pops = ["#f0ac54", "#c46686", "#faf9f5"]

type Shape = string
const shapes: Shape[] = []
const line = (attrs: string) => shapes.push(`<path fill="none" stroke="${ink}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" ${attrs}/>`)

// Pencil-grid texture shared by all covers.
const step = f(20 * s)
const dots: string[] = []
for (let x = step / 2; x < w; x += step) for (let y = step / 2; y < h; y += step) dots.push(`M${f(x)} ${f(y)}h0.01`)

const variant = Math.floor(r() * 3)

if (kind === "blog" && variant === 1) {
  // Distillation: a large teacher passes signal along curved paths to a small student.
  const tx = between(w * 0.22, w * 0.32)
  const ty = between(h * 0.4, h * 0.6)
  const tr = 42 * s
  const sx = between(w * 0.7, w * 0.8)
  const sy = between(h * 0.35, h * 0.65)
  const sr = 20 * s
  for (let k = -1; k <= 1; k++) {
    const bend = k * between(38, 58) * s
    const mx = (tx + sx) / 2
    const my = (ty + sy) / 2 + bend
    line(`stroke-dasharray="${f(2 * s)} ${f(9 * s)}" d="M${f(tx + tr)} ${f(ty)} Q${f(mx)} ${f(my)} ${f(sx - sr)} ${f(sy)}"`)
    shapes.push(`<circle cx="${f(mx)}" cy="${f((ty + sy) / 2 + bend / 2)}" r="${f(5 * s)}" fill="${k === 0 ? ink : pick(pops)}" stroke="${ink}" stroke-width="${sw}"/>`)
  }
  shapes.push(`<circle cx="${f(tx)}" cy="${f(ty)}" r="${f(tr)}" fill="${accent}" stroke="${ink}" stroke-width="${sw}"/>`)
  shapes.push(`<circle cx="${f(tx - tr * 0.3)}" cy="${f(ty - tr * 0.3)}" r="${f(tr * 0.22)}" fill="${paper}" stroke="${ink}" stroke-width="${sw}"/>`)
  shapes.push(`<circle cx="${f(sx)}" cy="${f(sy)}" r="${f(sr)}" fill="${paper}" stroke="${ink}" stroke-width="${sw}"/>`)
  shapes.push(`<circle cx="${f(sx)}" cy="${f(sy)}" r="${f(sr * 0.4)}" fill="${accent}"/>`)
} else if (kind === "blog" && variant === 2) {
  // A token stream: a row of tokens on a wave, with a feedback arc above.
  const n = Math.floor(between(6, 9))
  const x0 = w * 0.12
  const x1 = w * 0.88
  const amp = between(10, 22) * s
  const phase = between(0, Math.PI * 2)
  const cy = h * 0.6
  const size = Math.min(26 * s, ((x1 - x0) / n) * 0.72)
  const hot = Math.floor(r() * n)
  const pts: [number, number][] = []
  for (let i = 0; i < n; i++) {
    const x = x0 + ((x1 - x0) * (i + 0.5)) / n
    pts.push([x, cy + amp * Math.sin(phase + i * 0.9)])
  }
  line(`d="M${pts.map(([x, y]) => `${f(x)} ${f(y)}`).join(" L")}"`)
  pts.forEach(([x, y], i) =>
    shapes.push(`<rect x="${f(x - size / 2)}" y="${f(y - size / 2)}" width="${f(size)}" height="${f(size)}" rx="${f(5 * s)}" fill="${i === hot ? accent : i % 3 === 1 ? pick(pops) : paper}" stroke="${ink}" stroke-width="${sw}"/>`),
  )
  const [ax, ay] = pts[n - 1]
  const [bx, by] = pts[Math.max(0, hot - 1)]
  const top = Math.min(ay, by) - between(56, 72) * s
  line(`d="M${f(ax)} ${f(ay - size / 2 - 6 * s)} C${f(ax)} ${f(top)} ${f(bx)} ${f(top)} ${f(bx)} ${f(by - size / 2 - 6 * s)}"`)
  line(`d="M${f(bx - 7 * s)} ${f(by - size / 2 - 14 * s)} L${f(bx)} ${f(by - size / 2 - 6 * s)} L${f(bx + 7 * s)} ${f(by - size / 2 - 14 * s)}"`)
} else if (kind === "blog") {
  // An optimisation landscape: contour rings and a descent path to the minimum.
  const cx = between(w * 0.5, w * 0.72)
  const cy = between(h * 0.4, h * 0.62)
  const rot = between(-30, 30)
  const rings = 4
  for (let i = rings; i >= 1; i--) {
    const rx = f((22 + i * 26) * s * between(0.9, 1.1))
    const ry = f(rx * between(0.55, 0.7))
    const fill = i === 1 ? accent : i === rings ? paper : "none"
    shapes.push(
      `<ellipse cx="${f(cx)}" cy="${f(cy)}" rx="${rx}" ry="${ry}" transform="rotate(${f(rot)} ${f(cx)} ${f(cy)})" fill="${fill}" stroke="${ink}" stroke-width="${sw}"/>`,
    )
  }
  const pts: [number, number][] = [[between(w * 0.06, w * 0.18), between(h * 0.12, h * 0.3)]]
  for (let i = 1; i <= 4; i++) {
    const t = i / 4
    const [px, py] = pts[0]
    pts.push([px + (cx - px) * t + between(-14, 14) * s * (1 - t), py + (cy - py) * t + between(-18, 18) * s * (1 - t)])
  }
  line(`stroke-dasharray="${f(2 * s)} ${f(9 * s)}" d="M${pts.map(([x, y]) => `${f(x)} ${f(y)}`).join(" L")}"`)
  pts.slice(0, -1).forEach(([x, y], i) =>
    shapes.push(`<circle cx="${f(x)}" cy="${f(y)}" r="${f((i === 0 ? 7 : 4.5) * s)}" fill="${i === 0 ? pick(pops) : ink}" stroke="${ink}" stroke-width="${sw}"/>`),
  )
  shapes.push(`<circle cx="${f(cx)}" cy="${f(cy)}" r="${f(6 * s)}" fill="${ink}"/>`)
} else if (kind === "papers" && variant === 1) {
  // Baseline vs. method: two sheets, an arrow, and the new result highlighted.
  const pw = 84 * s
  const ph = 112 * s
  const gap = between(50, 70) * s
  const x0 = (w - (pw * 2 + gap)) / 2
  const y0 = (h - ph) / 2 + between(-8, 8) * s
  for (let k = 0; k < 2; k++) {
    const x = x0 + k * (pw + gap)
    const y = y0 + (k ? between(-10, 10) * s : 0)
    shapes.push(`<rect x="${f(x)}" y="${f(y)}" width="${f(pw)}" height="${f(ph)}" rx="${f(6 * s)}" fill="${paper}" stroke="${ink}" stroke-width="${sw}"/>`)
    const fh = between(30, 44) * s
    shapes.push(`<rect x="${f(x + 12 * s)}" y="${f(y + 14 * s)}" width="${f(pw - 24 * s)}" height="${f(fh)}" rx="${f(3 * s)}" fill="${k ? accent : pick(pops)}" stroke="${ink}" stroke-width="${f(sw * 0.8)}"/>`)
    for (let i = 0; i < 3; i++) {
      const y1 = y + 14 * s + fh + (14 + i * 13) * s
      if (y1 < y + ph - 8 * s) line(`stroke-width="${f(sw * 0.8)}" d="M${f(x + 12 * s)} ${f(y1)}h${f(between(30, pw / s - 24) * s)}"`)
    }
  }
  const ax = x0 + pw + 10 * s
  const bx = x0 + pw + gap - 10 * s
  const ay = h / 2
  line(`d="M${f(ax)} ${f(ay)} L${f(bx)} ${f(ay)} M${f(bx - 9 * s)} ${f(ay - 8 * s)} L${f(bx)} ${f(ay)} L${f(bx - 9 * s)} ${f(ay + 8 * s)}"`)
} else if (kind === "papers" && variant === 2) {
  // A stack of sheets with a bookmark: a reading pile.
  const pw = 120 * s
  const ph = 140 * s
  const cx = between(w * 0.4, w * 0.6)
  const cy = h / 2
  for (let k = 2; k >= 0; k--) {
    const rot = (k - 1) * between(5, 9)
    const fill = k === 0 ? paper : k === 1 ? pick(pops) : accent
    shapes.push(`<rect x="${f(cx - pw / 2)}" y="${f(cy - ph / 2)}" width="${f(pw)}" height="${f(ph)}" rx="${f(6 * s)}" transform="rotate(${f(rot)} ${f(cx)} ${f(cy)})" fill="${fill}" stroke="${ink}" stroke-width="${sw}"/>`)
  }
  for (let i = 0; i < 6; i++) {
    const y = cy - ph / 2 + (24 + i * 18) * s
    line(`stroke-width="${f(i === 0 ? sw * 1.4 : sw * 0.8)}" d="M${f(cx - pw / 2 + 16 * s)} ${f(y)}h${f((i === 0 ? 64 : between(50, 86)) * s)}"`)
  }
  const bx = cx + pw / 2 - 30 * s
  const by = cy - ph / 2 - 6 * s
  shapes.push(`<path d="M${f(bx)} ${f(by)} h${f(16 * s)} v${f(46 * s)} l${f(-8 * s)} ${f(-9 * s)} l${f(-8 * s)} ${f(9 * s)} z" fill="${accent}" stroke="${ink}" stroke-width="${sw}" stroke-linejoin="round"/>`)
} else if (kind === "papers") {
  // A page under the lens: tilted sheet, text lines, one highlighted finding.
  const pw = 112 * s
  const ph = 150 * s
  const px = between(w * 0.18, w * 0.4)
  const py = (h - ph) / 2
  const rot = between(-8, 8)
  const g: string[] = []
  g.push(`<rect x="${f(px)}" y="${f(py)}" width="${f(pw)}" height="${f(ph)}" rx="${f(6 * s)}" fill="${paper}" stroke="${ink}" stroke-width="${sw}"/>`)
  const hi = Math.floor(between(2, 6))
  for (let i = 0; i < 8; i++) {
    const y = py + (22 + i * 16) * s
    const len = (i === 0 ? 60 : between(46, 88)) * s
    if (i === hi) g.push(`<rect x="${f(px + 12 * s)}" y="${f(y - 6 * s)}" width="${f(len + 6 * s)}" height="${f(12 * s)}" fill="${accent}"/>`)
    g.push(`<path d="M${f(px + 15 * s)} ${f(y)}h${f(len)}" stroke="${ink}" stroke-width="${f(i === 0 ? sw * 1.4 : sw * 0.8)}" stroke-linecap="round"/>`)
  }
  shapes.push(`<g transform="rotate(${f(rot)} ${f(px + pw / 2)} ${f(py + ph / 2)})">${g.join("")}</g>`)
  const lx = px + pw + between(-6, 22) * s
  const ly = between(h * 0.3, h * 0.55)
  const lr = 34 * s
  shapes.push(`<circle cx="${f(lx)}" cy="${f(ly)}" r="${f(lr)}" fill="${pick(pops)}" fill-opacity="0.55" stroke="${ink}" stroke-width="${f(sw * 1.3)}"/>`)
  line(`stroke-width="${f(sw * 2.4)}" d="M${f(lx + lr * 0.72)} ${f(ly + lr * 0.72)} L${f(lx + lr * 1.7)} ${f(ly + lr * 1.7)}"`)
} else if (kind === "courses") {
  // Stacked layers: blocks of a model, wired top to bottom.
  const n = Math.floor(between(3, 5))
  const bh = 26 * s
  const gap = 16 * s
  const total = n * bh + (n - 1) * gap
  const top = (h - total) / 2
  const cx = between(w * 0.42, w * 0.62)
  for (let i = 0; i < n; i++) {
    const bw = between(96, 150) * s
    const y = top + i * (bh + gap)
    const fill = i === Math.floor(n / 2) ? accent : i % 2 ? pick(pops) : paper
    shapes.push(`<rect x="${f(cx - bw / 2)}" y="${f(y)}" width="${f(bw)}" height="${f(bh)}" rx="${f(8 * s)}" fill="${fill}" stroke="${ink}" stroke-width="${sw}"/>`)
    if (i < n - 1) line(`d="M${f(cx)} ${f(y + bh)}v${f(gap)}"`)
  }
  const side = cx + between(88, 104) * s * (r() > 0.5 ? 1 : -1)
  line(`stroke-dasharray="${f(2 * s)} ${f(8 * s)}" d="M${f(cx)} ${f(top - 10 * s)} C${f(side)} ${f(top - 10 * s)} ${f(side)} ${f(top + total + 10 * s)} ${f(cx)} ${f(top + total + 10 * s)}"`)
} else if (kind === "basics") {
  // A small concept graph: nodes and the edges between them.
  const n = Math.floor(between(5, 8))
  const nodes: [number, number, number][] = []
  for (let i = 0; i < n; i++) {
    let x = 0
    let y = 0
    for (let tries = 0; tries < 30; tries++) {
      x = between(w * 0.14, w * 0.86)
      y = between(h * 0.18, h * 0.82)
      if (nodes.every(([nx, ny]) => Math.hypot(nx - x, ny - y) > 46 * s)) break
    }
    nodes.push([x, y, between(9, 18) * s])
  }
  for (let i = 1; i < n; i++) {
    const j = Math.floor(r() * i)
    line(`d="M${f(nodes[i][0])} ${f(nodes[i][1])} L${f(nodes[j][0])} ${f(nodes[j][1])}"`)
  }
  nodes.forEach(([x, y, rad], i) =>
    shapes.push(`<circle cx="${f(x)}" cy="${f(y)}" r="${f(rad)}" fill="${i === 0 ? accent : i === n - 1 ? pick(pops) : paper}" stroke="${ink}" stroke-width="${sw}"/>`),
  )
} else {
  // Projects and everything else: a feedback loop (act, observe, update).
  const cx = between(w * 0.4, w * 0.6)
  const cy = h / 2
  const rad = 56 * s
  shapes.push(`<circle cx="${f(cx)}" cy="${f(cy)}" r="${f(rad * 0.42)}" fill="${accent}" stroke="${ink}" stroke-width="${sw}"/>`)
  const start = between(0, 360)
  for (let k = 0; k < 3; k++) {
    const a0 = ((start + k * 120 + 14) * Math.PI) / 180
    const a1 = ((start + k * 120 + 100) * Math.PI) / 180
    const x0 = cx + rad * Math.cos(a0)
    const y0 = cy + rad * Math.sin(a0)
    const x1 = cx + rad * Math.cos(a1)
    const y1 = cy + rad * Math.sin(a1)
    line(`d="M${f(x0)} ${f(y0)} A${f(rad)} ${f(rad)} 0 0 1 ${f(x1)} ${f(y1)}"`)
    const ah = 9 * s
    const tx = -Math.sin(a1)
    const ty = Math.cos(a1)
    line(`d="M${f(x1 - tx * ah + Math.cos(a1) * ah * 0.7)} ${f(y1 - ty * ah + Math.sin(a1) * ah * 0.7)} L${f(x1)} ${f(y1)} L${f(x1 - tx * ah - Math.cos(a1) * ah * 0.7)} ${f(y1 - ty * ah - Math.sin(a1) * ah * 0.7)}"`)
    const mx = cx + rad * 1.42 * Math.cos(a0 - 0.3)
    const my = cy + rad * 1.42 * Math.sin(a0 - 0.3)
    shapes.push(`<rect x="${f(mx - 9 * s)}" y="${f(my - 9 * s)}" width="${f(18 * s)}" height="${f(18 * s)}" rx="${f(4 * s)}" fill="${k === 0 ? pick(pops) : paper}" stroke="${ink}" stroke-width="${sw}"/>`)
  }
}

const svg = `<path d="${dots.join("")}" stroke="${ink}" stroke-opacity="0.16" stroke-width="${f(2.4 * s)}" stroke-linecap="round"/>${shapes.join("")}`
---

<svg
  class:list={["cover", className]}
  data-kind={kind}
  viewBox={`0 0 ${w} ${h}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  set:html={svg}
/>
