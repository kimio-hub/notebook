---
import { localeLabels, type Locale } from "../i18n/config"
import { getNav, switchLocalePath, t } from "../i18n/utils"
import { site } from "../data/site"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const pathname = Astro.url.pathname
const nav = getNav(lang)
const otherLang: Locale = lang === "zh" ? "en" : "zh"
const switchHref = switchLocalePath(pathname, otherLang)

function isActive(href: string) {
  if (href === "/" || href === "/en/") {
    return pathname === href
  }
  return pathname === href || pathname.startsWith(href)
}
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={nav[0]?.href ?? "/"}>
      <img src="/avatar.webp" alt="" width="28" height="28" />
      <span>{site.name}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label={t(lang, "nav.main")}>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="icon-btn" href={switchHref} hreflang={otherLang === "zh" ? "zh-CN" : "en"} aria-label={t(lang, "action.lang")} title={t(lang, "action.lang")}>
        {localeLabels[otherLang]}
      </a>
      <button
        class="icon-btn"
        id="theme-toggle"
        type="button"
        aria-label={t(lang, "action.theme")}
        aria-pressed="false"
        title={t(lang, "action.theme")}
      >
        <svg class="theme-icon-light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
        </svg>
        <svg class="theme-icon-dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <button
        class="icon-btn menu-toggle"
        id="menu-toggle"
        type="button"
        aria-label={t(lang, "action.menuOpen")}
        aria-controls="site-nav"
        aria-expanded="false"
        title={t(lang, "action.menuOpen")}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
