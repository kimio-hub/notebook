---
import { localeLabels, type Locale } from "../i18n/config"
import { getNav, switchLocalePath, t } from "../i18n/utils"
import { site } from "../data/site"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const pathname = Astro.url.pathname
const nav = getNav(lang)
const otherLang: Locale = lang === "zh" ? "en" : "zh"
const switchHref = switchLocalePath(pathname, otherLang)

function isActive(href: string) {
  if (href === "/" || href === "/en/") {
    return pathname === href
  }
  return pathname === href || pathname.startsWith(href)
}
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={nav[0]?.href ?? "/"}>
      <img src="/avatar.webp" alt={`${site.name}`} width="36" height="36" />
      <span class="brand-text">{site.name}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label={t(lang, "nav.main")}>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        class="icon-btn lang-switch"
        href={switchHref}
        aria-label={t(lang, "action.lang")}
        title={t(lang, "action.lang")}
      >
        <span class="lang-switch-label">{localeLabels[otherLang]}</span>
      </a>
      <a
        class="icon-btn"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t(lang, "action.github")}
        title={t(lang, "action.github")}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.75 5.48.75 11.76c0 4.98 3.23 9.2 7.7 10.69.56.1.77-.24.77-.54v-1.92c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 .1.72 1.72 2.72 1.72.76 0 1.42-.2 1.77-.4.1-.68.39-1.16.71-1.43-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.42.11-2.96 0 0 .95-.3 3.1 1.15a10.7 10.7 0 0 1 5.64 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.54.23 2.68.11 2.96.72.79 1.16 1.8 1.16 3.02 0 4.32-2.64 5.27-5.15 5.55.4.34.76 1.02.76 2.06v3.05c0 .3.2.65.78.54 4.46-1.49 7.68-5.71 7.68-10.69C23.25 5.48 18.27.5 12 .5Z"></path>
        </svg>
      </a>
      <button
        class="icon-btn"
        id="theme-toggle"
        type="button"
        aria-label={t(lang, "action.theme")}
        aria-pressed="false"
        title={t(lang, "action.theme")}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
        </svg>
      </button>
      <button
        class="icon-btn menu-toggle"
        id="menu-toggle"
        type="button"
        aria-label={t(lang, "action.menuOpen")}
        aria-controls="site-nav"
        aria-expanded="false"
        title={t(lang, "action.menuOpen")}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .lang-switch {
    min-width: 38px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .lang-switch-label {
    line-height: 1;
  }
</style>
