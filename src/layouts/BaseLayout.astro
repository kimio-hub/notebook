---
import "../styles/global.css"
import "katex/dist/katex.min.css"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { htmlLang, type Locale } from "../i18n/config"
import { getLocaleFromUrl, t } from "../i18n/utils"
import { homeTitle, site, siteDescription } from "../data/site"

interface Props {
  title?: string
  description?: string
  image?: string
  lang?: Locale
  type?: "website" | "article"
}

const lang = Astro.props.lang ?? getLocaleFromUrl(Astro.url)
const {
  title = site.title,
  description = siteDescription(lang),
  image = "/avatar.webp",
  type = "website",
} = Astro.props

const pageTitle =
  title === site.title || title === homeTitle(lang)
    ? homeTitle(lang)
    : `${title} · ${site.name}`
const canonical = new URL(Astro.url.pathname, site.url).toString()
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1e1d" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/webp" href="/avatar.webp" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).toString()} />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;600&family=Schibsted+Grotesk:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      ;(() => {
        const key = "kimio-theme"
        let saved = null
        try {
          saved = localStorage.getItem(key)
        } catch {
          // Storage can be unavailable in hardened/private browsing contexts.
        }
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
        if (saved === "dark" || (!saved && prefersDark)) {
          document.documentElement.classList.add("dark")
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, "action.skip")}</a>
    <Header lang={lang} />
    <main class="site-main" id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline define:vars={{ menuOpen: t(lang, "action.menuOpen"), menuClose: t(lang, "action.menuClose") }}>
      ;(() => {
        const key = "kimio-theme"
        const btn = document.getElementById("theme-toggle")
        const root = document.documentElement

        const updateThemeState = () => {
          btn?.setAttribute("aria-pressed", String(root.classList.contains("dark")))
        }

        updateThemeState()
        btn?.addEventListener("click", () => {
          const next = root.classList.toggle("dark") ? "dark" : "light"
          updateThemeState()
          try {
            localStorage.setItem(key, next)
          } catch {
            // The visual toggle still works when persistence is unavailable.
          }
          window.dispatchEvent(new Event("kimio-theme"))
        })

        const toggle = document.getElementById("menu-toggle")
        const nav = document.getElementById("site-nav")

        const setMenuOpen = (open) => {
          nav?.classList.toggle("open", open)
          toggle?.setAttribute("aria-expanded", String(open))
          toggle?.setAttribute("aria-label", open ? menuClose : menuOpen)
        }

        toggle?.addEventListener("click", () => {
          setMenuOpen(!nav?.classList.contains("open"))
        })

        nav?.addEventListener("click", (event) => {
          if (event.target instanceof HTMLAnchorElement) setMenuOpen(false)
        })

        document.addEventListener("click", (event) => {
          const target = event.target
          if (target instanceof Node && !nav?.contains(target) && !toggle?.contains(target)) {
            setMenuOpen(false)
          }
        })

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && nav?.classList.contains("open")) {
            setMenuOpen(false)
            toggle?.focus()
          }
        })

        window.matchMedia("(min-width: 861px)").addEventListener("change", (event) => {
          if (event.matches) setMenuOpen(false)
        })
      })()
    </script>
    <script is:inline>
      // Mermaid blocks are left unhighlighted at build time; render them only on pages that have one.
      ;(() => {
        const blocks = [...document.querySelectorAll("pre > code.language-mermaid")]
        if (!blocks.length) return
        const sources = blocks.map((code) => {
          const pre = code.parentElement
          pre.classList.add("mermaid-source")
          return { pre, text: code.textContent ?? "" }
        })
        let mermaid
        const render = async () => {
          mermaid ??= (await import("https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs")).default
          mermaid.initialize({
            startOnLoad: false,
            theme: document.documentElement.classList.contains("dark") ? "dark" : "neutral",
            fontFamily: "Schibsted Grotesk, PingFang SC, Microsoft YaHei, sans-serif",
          })
          for (const [index, source] of sources.entries()) {
            try {
              const { svg } = await mermaid.render(`mermaid-${index}-${Date.now()}`, source.text)
              const figure = document.createElement("div")
              figure.className = "mermaid"
              figure.innerHTML = svg
              source.pre.replaceWith(figure)
              source.pre = figure
            } catch {
              // Leave the source visible if rendering fails.
            }
          }
        }
        render()
        window.addEventListener("kimio-theme", render)
      })()
    </script>
  </body>
</html>
